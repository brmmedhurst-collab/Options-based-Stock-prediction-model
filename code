BACKTEST_OUTPUT_DIR = "./output/backtests"

def fetch_price_history(ticker: str, years: int = 5, interval: str = "1d") -> pd.DataFrame:
    """
    Download historical OHLC data for the chosen lookback.
    """
    tkr = yf.Ticker(ticker)
    period = f"{years}y"
    hist = tkr.history(period=period, interval=interval, auto_adjust=False)
    if hist.empty:
        raise RuntimeError(f"Could not fetch historical price data for {ticker}.")
    hist = hist.copy()
    hist.index = pd.to_datetime(hist.index).tz_localize(None)
    hist = hist.sort_index()
    return hist


def horizon_days_to_market_rows(days: int, trading_days_per_year: int = 252) -> int:
    """
    Convert calendar-day horizon to an approximate number of trading rows.
    Since historical data is usually daily bars, this is a practical approximation.
    """
    return max(1, int(round(days * trading_days_per_year / 365.0)))


def realized_abs_move_from_history(
    hist: pd.DataFrame,
    start_idx: int,
    horizon_days: int,
    price_col: str = "Close"
) -> Optional[float]:
    """
    Realized absolute move in dollars: |S_{t+h} - S_t|
    """
    h = horizon_days_to_market_rows(horizon_days)
    end_idx = start_idx + h
    if end_idx >= len(hist):
        return None
    s0 = float(hist.iloc[start_idx][price_col])
    s1 = float(hist.iloc[end_idx][price_col])
    if not (math.isfinite(s0) and math.isfinite(s1) and s0 > 0):
        return None
    return abs(s1 - s0)


def realized_pct_move_from_history(
    hist: pd.DataFrame,
    start_idx: int,
    horizon_days: int,
    price_col: str = "Close"
) -> Optional[float]:
    """
    Realized absolute move in percent: |S_{t+h} - S_t| / S_t
    """
    h = horizon_days_to_market_rows(horizon_days)
    end_idx = start_idx + h
    if end_idx >= len(hist):
        return None
    s0 = float(hist.iloc[start_idx][price_col])
    s1 = float(hist.iloc[end_idx][price_col])
    if not (math.isfinite(s0) and math.isfinite(s1) and s0 > 0):
        return None
    return abs(s1 - s0) / s0


def nearest_history_date_index(hist: pd.DataFrame, dt: datetime) -> Optional[int]:
    """
    Find the nearest historical row index at or before a datetime.
    """
    if hist.empty:
        return None
    ts = pd.Timestamp(dt).tz_localize(None)
    eligible = hist.index[hist.index <= ts]
    if len(eligible) == 0:
        return None
    return int(hist.index.get_loc(eligible[-1]))


def estimate_move_from_realized_vol(
    hist: pd.DataFrame,
    idx: int,
    horizon_days: int,
    lookback_days: int = 60,
    price_col: str = "Close"
) -> Optional[Tuple[float, float]]:
    """
    Fallback historical-volatility predictor.
    This is NOT options-implied. It is here only so the backtest framework works
    immediately even without historical options-chain snapshots.

    Returns:
        (predicted_abs_move, predicted_pct_move)
    """
    if idx <= 1:
        return None
    start = max(1, idx - lookback_days)
    px = hist.iloc[start:idx + 1][price_col].astype(float)
    rets = np.log(px / px.shift(1)).dropna()
    if len(rets) < 10:
        return None
    daily_vol = float(rets.std())
    horizon_rows = horizon_days_to_market_rows(horizon_days)
    move_pct = daily_vol * math.sqrt(horizon_rows)
    spot = float(hist.iloc[idx][price_col])
    move_abs = spot * move_pct
    return move_abs, move_pct


def predict_expected_move_on_date(
    ticker: str,
    asof_dt: datetime,
    horizon_days: int,
    hist: Optional[pd.DataFrame] = None,
    method: str = "hv_proxy",
) -> Dict[str, Optional[float]]:
    """
    Prediction hook used by the backtester.

    IMPORTANT:
    - Right now this supports a working proxy method: 'hv_proxy'
    - Later, when you have historical options-chain data, replace or extend this
      function with a true historical-options predictor.

    Output dict keys:
        predicted_abs
        predicted_pct
        method
    """
    if hist is None or hist.empty:
        return {"predicted_abs": None, "predicted_pct": None, "method": method}

    idx = nearest_history_date_index(hist, asof_dt)
    if idx is None:
        return {"predicted_abs": None, "predicted_pct": None, "method": method}

    if method == "hv_proxy":
        pred = estimate_move_from_realized_vol(hist, idx, horizon_days)
        if pred is None:
            return {"predicted_abs": None, "predicted_pct": None, "method": method}
        pred_abs, pred_pct = pred
        return {"predicted_abs": pred_abs, "predicted_pct": pred_pct, "method": method}

    # -------------------------------------------------------------------------
    # FUTURE EXTENSION POINT:
    # Add your true historical options-based predictor here once you have access
    # to historical option chains for each as-of date.
    #
    # Example:
    # if method == "historical_options":
    #     pred_abs, pred_pct = your_historical_options_function(ticker, asof_dt, horizon_days)
    #     return {"predicted_abs": pred_abs, "predicted_pct": pred_pct, "method": method}
    # -------------------------------------------------------------------------

    return {"predicted_abs": None, "predicted_pct": None, "method": method}


def backtest_single_horizon(
    ticker: str,
    hist: pd.DataFrame,
    horizon_label: str,
    horizon_days: int,
    step_days: int = 3,
    method: str = "hv_proxy",
    price_col: str = "Close",
) -> pd.DataFrame:
    """
    Rolling historical backtest for a single horizon.

    Every `step_days` rows, the model predicts the future move over the chosen horizon.
    Then it compares prediction vs realized move.
    """
    rows = []
    step_rows = max(1, horizon_days_to_market_rows(step_days))
    max_i = len(hist) - horizon_days_to_market_rows(horizon_days) - 1

    for i in range(0, max_i + 1, step_rows):
        asof_dt = hist.index[i].to_pydatetime()
        s0 = float(hist.iloc[i][price_col])

        pred = predict_expected_move_on_date(
            ticker=ticker,
            asof_dt=asof_dt,
            horizon_days=horizon_days,
            hist=hist,
            method=method,
        )
        pred_abs = pred["predicted_abs"]
        pred_pct = pred["predicted_pct"]

        real_abs = realized_abs_move_from_history(hist, i, horizon_days, price_col=price_col)
        real_pct = realized_pct_move_from_history(hist, i, horizon_days, price_col=price_col)

        if pred_abs is None or pred_pct is None or real_abs is None or real_pct is None:
            continue

        signed_error_abs = pred_abs - real_abs
        abs_error_abs = abs(signed_error_abs)

        signed_error_pct = pred_pct - real_pct
        abs_error_pct = abs(signed_error_pct)

        ratio = (pred_abs / real_abs) if real_abs > 1e-12 else np.nan

        rows.append({
            "ticker": ticker,
            "horizon": horizon_label,
            "horizon_days": horizon_days,
            "asof_date": asof_dt.date().isoformat(),
            "spot": s0,
            "predicted_abs": pred_abs,
            "predicted_pct": pred_pct,
            "realized_abs": real_abs,
            "realized_pct": real_pct,
            "signed_error_abs": signed_error_abs,
            "abs_error_abs": abs_error_abs,
            "signed_error_pct": signed_error_pct,
            "abs_error_pct": abs_error_pct,
            "prediction_to_realized_ratio": ratio,
            "method": pred["method"],
        })

    return pd.DataFrame(rows)


def summarize_backtest_results(df_bt: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate stats by horizon.
    """
    if df_bt.empty:
        return pd.DataFrame()

    def rmse(x):
        x = pd.Series(x).dropna()
        return float(np.sqrt(np.mean(np.square(x)))) if len(x) else np.nan

    grouped = df_bt.groupby(["ticker", "horizon", "horizon_days", "method"], dropna=False)

    out = grouped.agg(
        n_tests=("asof_date", "count"),
        mean_pred_abs=("predicted_abs", "mean"),
        mean_real_abs=("realized_abs", "mean"),
        mean_signed_error_abs=("signed_error_abs", "mean"),
        std_signed_error_abs=("signed_error_abs", "std"),
        mae_abs=("abs_error_abs", "mean"),
        mean_pred_pct=("predicted_pct", "mean"),
        mean_real_pct=("realized_pct", "mean"),
        mean_signed_error_pct=("signed_error_pct", "mean"),
        std_signed_error_pct=("signed_error_pct", "std"),
        mae_pct=("abs_error_pct", "mean"),
        mean_ratio=("prediction_to_realized_ratio", "mean"),
        std_ratio=("prediction_to_realized_ratio", "std"),
    ).reset_index()

    rmse_abs_vals = grouped["signed_error_abs"].apply(rmse).reset_index(name="rmse_abs")
    rmse_pct_vals = grouped["signed_error_pct"].apply(rmse).reset_index(name="rmse_pct")

    out = out.merge(rmse_abs_vals, on=["ticker", "horizon", "horizon_days", "method"], how="left")
    out = out.merge(rmse_pct_vals, on=["ticker", "horizon", "horizon_days", "method"], how="left")

    return out.sort_values("horizon_days").reset_index(drop=True)


def plot_backtest_horizon(df_h: pd.DataFrame, output_dir: str) -> Optional[str]:
    """
    Make a chart for one horizon showing predicted vs realized move and error.
    """
    if df_h.empty:
        return None

    horizon = str(df_h["horizon"].iloc[0])
    ticker = str(df_h["ticker"].iloc[0])
    method = str(df_h["method"].iloc[0])

    df_plot = df_h.copy()
    df_plot["asof_date"] = pd.to_datetime(df_plot["asof_date"])
    df_plot = df_plot.sort_values("asof_date")

    fig = plt.figure(figsize=(12, 6))
    ax = fig.add_subplot(111)
    ax.plot(df_plot["asof_date"], df_plot["predicted_pct"] * 100, label="Predicted move (%)")
    ax.plot(df_plot["asof_date"], df_plot["realized_pct"] * 100, label="Realized move (%)")
    ax.plot(df_plot["asof_date"], df_plot["signed_error_pct"] * 100, label="Signed error (%)", alpha=0.7)

    ax.set_title(f"{ticker} | {horizon} backtest | method={method}")
    ax.set_xlabel("As-of date")
    ax.set_ylabel("Percent move / error")
    ax.legend()
    ax.grid(True, alpha=0.3)
    fig.tight_layout()

    os.makedirs(output_dir, exist_ok=True)
    path = os.path.join(output_dir, f"{ticker}_{horizon}_{method}_backtest.png")
    fig.savefig(path, dpi=140)
    plt.close(fig)
    return path


def run_full_backtest(
    ticker: str,
    years: int = 5,
    step_days: int = 3,
    method: str = "hv_proxy",
    horizons: Optional[Dict[str, int]] = None,
    price_col: str = "Close",
    make_charts: bool = True,
) -> Tuple[pd.DataFrame, pd.DataFrame, List[str]]:
    """
    Run the backtest across all requested horizons.
    Returns:
        df_all_tests, df_summary, chart_paths
    """
    if horizons is None:
        horizons = TARGET_HORIZONS_DAYS

    hist = fetch_price_history(ticker, years=years, interval="1d")

    all_parts = []
    chart_paths = []

    for label, days in horizons.items():
        df_h = backtest_single_horizon(
            ticker=ticker,
            hist=hist,
            horizon_label=label,
            horizon_days=days,
            step_days=step_days,
            method=method,
            price_col=price_col,
        )
        if not df_h.empty:
            all_parts.append(df_h)
            if make_charts:
                chart = plot_backtest_horizon(df_h, BACKTEST_OUTPUT_DIR)
                if chart is not None:
                    chart_paths.append(chart)

    if not all_parts:
        return pd.DataFrame(), pd.DataFrame(), []

    df_all = pd.concat(all_parts, ignore_index=True)
    df_summary = summarize_backtest_results(df_all)

    os.makedirs(BACKTEST_OUTPUT_DIR, exist_ok=True)
    all_csv = os.path.join(BACKTEST_OUTPUT_DIR, f"{ticker}_{method}_all_backtests.csv")
    summary_csv = os.path.join(BACKTEST_OUTPUT_DIR, f"{ticker}_{method}_summary.csv")
    df_all.to_csv(all_csv, index=False)
    df_summary.to_csv(summary_csv, index=False)

    return df_all, df_summary, chart_paths


def print_backtest_summary(df_summary: pd.DataFrame) -> None:
    """
    Console-friendly summary output.
    """
    if df_summary.empty:
        print("\nNo backtest results to display.\n")
        return

    df_show = df_summary.copy()

    pct_cols = [
        "mean_pred_pct", "mean_real_pct",
        "mean_signed_error_pct", "std_signed_error_pct",
        "mae_pct", "rmse_pct"
    ]
    cash_cols = [
        "mean_pred_abs", "mean_real_abs",
        "mean_signed_error_abs", "std_signed_error_abs",
        "mae_abs", "rmse_abs"
    ]
    ratio_cols = ["mean_ratio", "std_ratio"]

    for c in pct_cols:
        if c in df_show.columns:
            df_show[c] = df_show[c].apply(lambda x: None if pd.isna(x) else f"{x:.2%}")

    for c in cash_cols:
        if c in df_show.columns:
            df_show[c] = df_show[c].apply(lambda x: None if pd.isna(x) else f"${x:,.4f}")

    for c in ratio_cols:
        if c in df_show.columns:
            df_show[c] = df_show[c].apply(lambda x: None if pd.isna(x) else f"{x:.4f}")

    print("\n=== Backtest Summary by Horizon ===\n")
    print(tabulate(df_show, headers="keys", tablefmt="github", showindex=False))


